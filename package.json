{
  "name": "turnos-backend",
  "version": "1.0.0",
  "description": "Backend de Turnos - Hernandez 1 (barbería)",
  "main": "src/server.js",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "postinstall": "prisma generate",
    "dev": "nodemon src/server.js",
    "start": "node prisma/seed.js && node src/server.js",
    "seed": "node prisma/seed.js",
    "db:push": "prisma db push",
    "build": "npm install && npx prisma generate && npx prisma db push"
  },
  "dependencies": {
    "@prisma/client": "^5.20.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "nodemon": "^3.1.4",
    "prisma": "^5.20.0"
  }
}
